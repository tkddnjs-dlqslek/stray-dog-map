# 카카오맵 JavaScript 키 (developers.kakao.com에서 발급, 플랫폼>Web 도메인 등록 필요)
# 설정하면 지도가 카카오맵으로 전환되고, 없으면 OpenStreetMap(Leaflet)으로 폴백됩니다.
NEXT_PUBLIC_KAKAO_MAP_KEY=

# 동물보호관리시스템 공공 API 서비스키 (data.go.kr 발급, 디코딩 키)
# 설정하면 전국 공공 보호소가 자동으로 합쳐집니다. 없으면 시드 데이터만 사용.
ANIMAL_SERVICE_KEY=

# 예약 알림 이메일(SMTP) — Gmail/Naver/SES 등 아무 SMTP나 사용 가능
# 설정돼 있고 보호소가 알림 이메일을 등록하면 예약 시 메일이 발송됩니다.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL_FROM=멍플래너 <no-reply@mungplanner.kr>
# (선택) 보호소별 설정이 없을 때 쓰는 폴백 수신 주소/웹훅
NOTIFY_EMAIL_TO_DEFAULT=
NOTIFY_WEBHOOK_DEFAULT=
