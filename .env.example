# 카카오맵 JavaScript 키 (developers.kakao.com에서 발급, 플랫폼>Web 도메인 등록 필요)
# 설정하면 지도가 카카오맵으로 전환되고, 없으면 OpenStreetMap(Leaflet)으로 폴백됩니다.
NEXT_PUBLIC_KAKAO_MAP_KEY=

# 동물보호관리시스템 공공 API 서비스키 (data.go.kr 발급, 디코딩 키)
# 설정하면 전국 공공 보호소(약 228개소)가 자동으로 합쳐집니다. 없으면 시드 데이터만 사용.
ANIMAL_SERVICE_KEY=
# (테스트용) 공공 API 엔드포인트 베이스 교체 — 모킹 검증 시에만 사용
ANIMAL_API_BASE=

# 관리자 토큰 — 설정하면 검수(/admin)·공공 진단 API에 x-admin-token 헤더가 필요.
# 운영 배포 전 반드시 설정하세요. 미설정 시 MVP로 열려 있습니다.
ADMIN_TOKEN=

# Supabase(Postgres) — 둘 다 설정되면 파일 대신 DB에 영속화합니다(미설정 시 파일 백엔드).
# 스키마는 supabase/schema.sql 실행. SERVICE_ROLE 키는 서버 전용, 절대 클라이언트 노출 금지.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 예약 알림 이메일(SMTP) — Gmail/Naver/SES 등 아무 SMTP나 사용 가능
# 설정돼 있고 보호소가 알림 이메일을 등록하면 예약 시 메일이 발송됩니다.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL_FROM=멍플래너 <no-reply@mungplanner.kr>
# (선택) 보호소별 설정이 없을 때 쓰는 폴백 수신 주소/웹훅
NOTIFY_EMAIL_TO_DEFAULT=
NOTIFY_WEBHOOK_DEFAULT=
